# ============================================================
#  fashionpedia_api/.env  — copy this file and fill in paths
#  DO NOT commit this file to git (add .env to .gitignore)
# ============================================================

# ── Paths (update these to match your local setup) ───────────
CHECKPOINT_PATH=./fashionpedia_runs/ablation_B_stage4_head/checkpoints/best.pt
PROCESSED_DIR=./fashionpedia_processed

# ── LLM backend: "local" (Qwen2.5-0.5B) or "claude" (Haiku API)
LLM_BACKEND=local

# ── Only needed if LLM_BACKEND=claude ─────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Attribute classifier tuning ───────────────────────────────
ATTRIBUTE_THRESHOLD=0.45
TOP_K_ATTRIBUTES=20

# ── Detection strategy: "centrecrop" or "saliency" ────────────
DETECTION_STRATEGY=centrecrop
CENTRECROP_FRACTION=0.85

# ── ConvNeXt head architecture (must match your training CFG) ─
HEAD_HIDDEN_DIM=512
UNFREEZE_FROM_BLOCK=6

# ── API settings ──────────────────────────────────────────────
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
